<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.recalldesk</groupId>
    <artifactId>recalldesk-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>recalldesk-interfaces</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.recalldesk</groupId>
      <artifactId>recalldesk-application</artifactId>
    </dependency>
    <dependency>
      <groupId>com.recalldesk</groupId>
      <artifactId>recalldesk-infrastructure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Boot 父 POM 已把 repackage 绑到 package 阶段：这里只点名插件，不再声明 execution，
           否则同一个 jar 被重打包两次。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
