# 本文件同时驱动宿主机直跑进程和 docker compose 容器：业务参数两边共用；
# 地址类变量（DATABASE_URL / REDIS_URL / NEO4J_URI / EMBEDDING_BASE_URL / RERANK_OLLAMA_URL /
# DATA_DIR）只对宿主机生效 —— compose 在容器里把它们覆盖成服务名 / host.docker.internal / /app/data

# PostgreSQL：文档元数据（对应 docker-compose.yml 里的 postgres 服务）
DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5435/anna_rag

# Redis Stream：任务队列（本机 6380，对应 compose 映射；6379 被本机其它 Redis 占用；文档索引 / Eval 出题 / Eval 逐题评测各一条 stream）
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_DOCUMENT_TASK_STREAM=anna_rag_document_tasks
REDIS_DOCUMENT_CONSUMER_GROUP=anna_rag_document_workers
REDIS_EVAL_TASK_STREAM=anna_rag_eval_tasks
REDIS_EVAL_CONSUMER_GROUP=anna_rag_eval_workers
REDIS_EVAL_RUN_TASK_STREAM=anna_rag_eval_run_tasks
REDIS_EVAL_RUN_CONSUMER_GROUP=anna_rag_eval_run_workers
REDIS_STREAM_MAXLEN=10000
REDIS_CLAIM_MIN_IDLE_MS=60000
REDIS_CLAIM_START_ID=0-0

# 后台任务：发布轮询间隔 / 每批数量 / 最大重试次数
TASK_PUBLISH_INTERVAL_SECONDS=0.5
TASK_PUBLISH_BATCH_SIZE=50
TASK_MAX_ATTEMPTS=10

# Eval 出题任务：LLM 失败率高，节奏比文档索引放宽
EVAL_TASK_PUBLISH_INTERVAL_SECONDS=2.0
EVAL_TASK_PUBLISH_BATCH_SIZE=20
EVAL_TASK_MAX_ATTEMPTS=5

# Eval 逐题评测任务：一次任务=一次检索，比出题便宜，投递更勤、重试预算更小
EVAL_RUN_TASK_PUBLISH_INTERVAL_SECONDS=1.0
EVAL_RUN_TASK_PUBLISH_BATCH_SIZE=50
EVAL_RUN_TASK_MAX_ATTEMPTS=3

# Neo4j：chunk 检索索引（HNSW 向量 + Lucene 全文 BM25），未来的知识图谱也住这里
# 本机 7688（bolt）/ 7475（浏览器）；7687/7474 被本机另一套 Neo4j 占用，错开
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=recalldesk
# 换 embedding 模型时同步改 EMBEDDING_DIM，并确保索引维度一致（启动会 fail-fast 校验）
EMBEDDING_DIM=1024
CHUNK_FULLTEXT_ANALYZER=cjk

# Embedding（本机 Ollama）
EMBEDDING_MODEL=mxbai-embed-large:latest
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama

# 分块参数
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# 检索默认返回数量
TOP_K=5

# LLM（OpenAI 兼容中转；query rewrite 使用，留空则不可用）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 查询改写：依赖上面的 OpenAI 兼容 LLM，缺 LLM 时开关无效
QUERY_REWRITE_ENABLED=false

# Rerank：Ollama 上的 Qwen3-Reranker（生成式重排，judge prompt + logprobs 取分）
# 不再依赖 LLM 中转；num_ctx 压到 4096 是为了防 OOM（模型默认 40K 会吃 ~9GB 内存）
RERANK_ENABLED=false
RERANK_TOP_N=20
RERANK_CANDIDATE_CHARS=500
RERANK_OLLAMA_URL=http://127.0.0.1:11434
RERANK_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANK_NUM_CTX=4096
RERANK_TIMEOUT_SECONDS=60

# 上传限制
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.pdf

# 本地数据目录（原始文件）
DATA_DIR=data

# ---- 知识图谱（第三路召回 + 文档抽取链路；中转站可用时再开）----
# 开启后：索引成功的文档自动入队抽取（GRAPH_* 任务链），检索多一路图候选
GRAPH_ENABLED=false
GRAPH_HOPS=2
GRAPH_CANDIDATES=20
# 向量链接余弦下限（LightRAG 式兜底链接；<=0 关闭该路）
GRAPH_LINK_MIN_SCORE=0.72
GRAPH_EXTRACT_CONCURRENCY=2
REDIS_GRAPH_TASK_STREAM=anna_rag_graph_tasks
REDIS_GRAPH_CONSUMER_GROUP=anna_rag_graph_workers
GRAPH_TASK_PUBLISH_INTERVAL_SECONDS=1.0
GRAPH_TASK_PUBLISH_BATCH_SIZE=20
GRAPH_TASK_MAX_ATTEMPTS=5
GRAPH_TASK_RETRY_BACKOFF_BASE_SECONDS=30
