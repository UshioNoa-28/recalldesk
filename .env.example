# 本文件同时驱动宿主机直跑的 jar 和 docker compose 容器：业务参数两边共用；
# 地址类变量（JDBC_URL / REDIS_HOST / MODEL_SERVICE_URL / OLLAMA_BASE_URL /
# DATA_DIR）只对宿主机生效 —— compose 在容器里把它们覆盖成服务名 / /app/data

# PostgreSQL：文档元数据 + chunk 检索索引（pgvector 稠密路 + pg_search BM25 稀疏路）
# 用 ParadeDB 镜像而不是官方 postgres：pg_search 需要服务端启动时 loaded
JDBC_URL=jdbc:postgresql://127.0.0.1:5435/anna_rag
DATABASE_USER=rag
DATABASE_PASSWORD=rag

# Redis Stream：任务队列（本机 6380，对应 compose 映射；6379 被本机其它 Redis 占用；文档索引 / Eval 逐题评测各一条 stream）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DOCUMENT_TASK_STREAM=anna_rag_document_tasks
REDIS_DOCUMENT_CONSUMER_GROUP=anna_rag_document_workers
REDIS_EVAL_RUN_TASK_STREAM=anna_rag_eval_run_tasks
REDIS_EVAL_RUN_CONSUMER_GROUP=anna_rag_eval_run_workers
REDIS_STREAM_MAXLEN=10000
REDIS_CLAIM_MIN_IDLE_MS=60000
REDIS_CLAIM_START_ID=0-0

# 后台任务：发布轮询间隔 / 每批数量 / 最大重试次数
TASK_PUBLISH_INTERVAL_SECONDS=0.5
TASK_PUBLISH_BATCH_SIZE=50
TASK_MAX_ATTEMPTS=10

# Eval 逐题评测任务：一次任务=一次检索，比出题便宜，投递更勤、重试预算更小
EVAL_RUN_TASK_PUBLISH_INTERVAL_SECONDS=1.0
EVAL_RUN_TASK_PUBLISH_BATCH_SIZE=50
EVAL_RUN_TASK_MAX_ATTEMPTS=3

# 失败重投的退避基数（秒）：第 n 次失败后等 base * 2^(n-1) 秒再投
TASK_RETRY_BACKOFF_BASE_SECONDS=30
EVAL_RUN_TASK_RETRY_BACKOFF_BASE_SECONDS=10

# chunk 检索索引（住在 PostgreSQL 里，见上面 JDBC_URL）
# EMBEDDING_DIM 换 embedding 模型时同步改，但要配一条迁移重建 embedding 列——
# 维度钉在迁移里，启动期只做一致性校验（不符直接拒绝启动）
EMBEDDING_DIM=1024
# BM25 分词器（pg_search）：中文按字切分的 chinese_compatible / 词典分词的 chinese_lindera。
# 换分词等于重建索引，sparse 基线要重跑，所以这里改了就等于实验口径变了
CHUNK_TEXT_TOKENIZER=chinese_compatible

# 模型网关（model-service）：Java 只认这一个地址，embedding / rerank / 改写都在网关后面
# 宿主机直跑用 8002（compose 把网关映射到宿主机 8002）；容器里覆盖成 http://model:8000
MODEL_SERVICE_URL=http://127.0.0.1:8002

# 网关背后的 Ollama（只被 model-service 读取；Java 不认识它）
# 宿主机直跑用 127.0.0.1:11434；compose 里覆盖成 http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
# CPU 上一次 embedding 请求带几条文本
EMBEDDING_BATCH_SIZE=32

# Java 侧等网关的天花板（秒）：重排候选多、CPU 慢，整体超时给得比单次调用宽
MODEL_EMBED_TIMEOUT_SECONDS=120
MODEL_RERANK_TIMEOUT_SECONDS=900
MODEL_REWRITE_TIMEOUT_SECONDS=180

# 分块参数
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# 检索默认返回数量
TOP_K=5

# LLM（OpenAI 兼容中转；model-service 用它做 query rewrite，留空则改写路不可用）
# 配了即接入改写路；每次检索开不开改写是评测 run 的 config（消融实验），不在 env 里存
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
# 透传给 OpenAI 兼容端点（思考型模型常需 {"enable_thinking": false}）
LLM_EXTRA_BODY=
# 一次改写要几个语义变体
REWRITE_N_VARIANTS=3

# Rerank：Ollama 上的 Qwen3-Reranker（生成式重排，judge prompt + logprobs 取分）
# 模型与 prompt 在 model-service 里；这里只调模型与资源上限
# num_ctx 压到 4096 是为了防 OOM（模型默认 40K 会吃 ~9GB 内存）
# 注意：dengcao/Qwen3-Reranker-0.6B:Q8_0 实测任何输入都输出 "3"（首 token 无 yes/no），
# 重排分会全为 0、检索仍可用但没有重排效果；换能输出 yes/no 的模型，或把 RERANK_MODEL 留空关闭重排
RERANK_TOP_N=20
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:Q8_0
RERANK_CANDIDATE_CHARS=500
RERANK_NUM_CTX=4096
RERANK_TIMEOUT_SECONDS=180
# 2C2G 上默认 1；内存够了再往上加
RERANK_CONCURRENCY=1
RERANK_KEEP_ALIVE=1h

# 融合（多路召回的结果怎么合）：交互式查询 /search 的默认档
# 评测 run 一律在自己的 config 里显式带 fusion 做 A/B，所以「这次实验用哪种融合」
# 不在这里存 —— env 管默认，run 管实验
# FUSION_METHOD：rrf（只看名次，跨路无需可比假设）| weighted（路内归一化后按组加权）
# FUSION_RRF_K：RRF 分母常数，越大越不看头部名次差
# FUSION_NORM：weighted 档的归一化方式，minmax | zscore
# FUSION_WEIGHTS：按路组给权重（dense/sparse），组内多条改写列表平摊；JSON 写法
FUSION_METHOD=rrf
FUSION_RRF_K=60
FUSION_NORM=minmax
FUSION_WEIGHTS={"dense":1.0,"sparse":1.0}

# 上传限制（白名单只收 txt/md，写在 DocumentController 里，没有 env 开关）

# 本地数据目录（原始文件）
DATA_DIR=data

# ---- 鉴权：自写 JWT（不引 Spring Security）----
# JWT_SECRET 至少 32 字节，缺失或过短会在启动期直接失败（不退化成"不验签"）
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d
# 公开路径前缀，除这几条之外一律要 access 令牌
JWT_PUBLIC_PATHS=/auth/email-code,/auth/register,/auth/login,/auth/refresh,/health

# ---- 注册验证码邮件（QQ 邮箱示例）----
# SMTP_PASSWORD 是邮箱的「授权码」，不是登录密码；只放环境变量，别提交进仓库
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
EMAIL_CODE_TTL=10m

# ---- 限流 ----
# 桶容量与回填速率写在 PerUserRateLimiter / PerCredentialRateLimiter 里，这里只有开关
RATE_LIMIT_ENABLED=true
